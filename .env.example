# ── PolCRM - plik konfiguracyjny środowiska ────────────────
# Skopiuj ten plik jako `.env` i uzupełnij wartości.
# NIGDY nie commituj `.env` do repozytorium!

# ── Sekrety (wygeneruj przez: python scripts/generate_keys.py) ─
# 64 znaki hex - podpisuje sesje Flask i tokeny CSRF
FLASK_SECRET_KEY=

# Klucz Fernet (44 znaki base64): szyfruje w bazie klucze API, hasło SMTP i tokeny Google.
# W produkcji wymagany. W dev, gdy pusty, aplikacja tworzy instance/fernet_dev.key.
FERNET_KEY=

# ── Tryb pracy ─────────────────────────────────────────────────
# development | production
# Lokalnie .env nie jest potrzebny (scripts/start.bat ustawia development). W production
# aplikacja nie wystartuje bez FLASK_SECRET_KEY, a bez FERNET_KEY nie zapisze ani nie odczyta
# zaszyfrowanych sekretów (klucze API, hasło SMTP, tokeny Google).
FLASK_ENV=production

# Język interfejsu przed zalogowaniem i domyślnych szablonów (umowy, e-maile, baza wiedzy)
# tworzonych przy pierwszym starcie; każda osoba zmienia swój język w profilu. pl | en
DEFAULT_LANGUAGE=pl

# Host i port (produkcja: 127.0.0.1, tylko localhost - Cloudflare Tunnel albo reverse proxy robi resztę)
APP_HOST=127.0.0.1
APP_PORT=4666

# ── Logowanie ─────────────────────────────────────────────────
# password   - e-mail i hasło; konta zakłada admin w Ustawienia → Zespół (domyślnie)
# cloudflare - tożsamość z nagłówka Cloudflare Access (aplikacja tylko za Access/Tunnel)
# profile    - wybór profilu bez hasła, wyłącznie do lokalnego demo (zablokowany w produkcji)
# Pierwsze konto administratora: strona /setup przy pierwszym uruchomieniu
# albo: python scripts/create_admin.py --name "Imię Nazwisko" --email adres@example.com
AUTH_MODE=password

# Tylko dla AUTH_MODE=cloudflare: dodatkowa lista dozwolonych e-maili po stronie aplikacji
# (Cloudflare Access sprawdza je pierwszy). Stare CF_ACCESS_ENABLED=true nadal znaczy cloudflare.
ALLOWED_EMAILS=anna@example.com,tomasz@example.com

# ── Cookie / HTTPS ────────────────────────────────────────────
# true, jeśli aplikacja jest dostępna przez HTTPS (Cloudflare zawsze TAK)
SESSION_COOKIE_SECURE=true

# ── AI Assistant (OpenRouter) ──────────────────────────────────
# Wygeneruj klucz: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Model (zmień jeśli okaże się za słaby):
#   - google/gemini-3.1-flash-lite-preview   - bardzo tani, preview
#   - google/gemini-2.5-flash                - stabilny, tani
#   - anthropic/claude-haiku-4.5             - świetny polski, tool use, rozsądna cena
#   - openai/gpt-4o-mini                     - najtańszy z OpenAI
ASSISTANT_MODEL=google/gemini-3.1-flash-lite-preview

# Inny endpoint zgodny z OpenAI zamiast OpenRouter (opcjonalne), np. bramka LiteLLM
# albo lokalny model: OPENROUTER_URL=http://127.0.0.1:4000/v1/chat/completions
# OPENROUTER_URL=

# URL aplikacji (dla OpenRouter HTTP-Referer nagłówka - opcjonalne)
APP_URL=http://localhost:4666

# ── Baza danych (opcjonalne) ──────────────────────────────────
# Domyślnie SQLite w instance/hub.db (wystarcza dla małego zespołu).
# PostgreSQL (większy zespół, kopie zapasowe narzędziami bazy):
# DATABASE_URL=postgresql+psycopg://polcrm:HASLO@127.0.0.1:5432/polcrm
# Inna ścieżka SQLite:
# DATABASE_URL=sqlite:////srv/polcrm/data/hub.db

# Hasło bazy dla docker-compose.yml (kontener PostgreSQL); compose sam ustawia DATABASE_URL
POSTGRES_PASSWORD=
